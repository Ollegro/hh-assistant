# hh-assistant: настройки (скопируйте в .env и заполните)
# User-Agent обязателен для запросов к hh (формат: Название/версия (email))
HH_USER_AGENT=hh-assistant/0.1 (user@example.com)

# Лимиты и пороги
# 200 — максимум, который разрешает hh.ru; на практике полезнее 30–50 точных откликов в день
DAILY_LIMIT=200
SCORE_THRESHOLD=55
# Через сколько дней отклик без ответа считается «молчанием» (страница «Воронка», cli funnel)
REPLY_WAIT_DAYS=14

# Сбор вакансий (кнопка «Собрать вакансии» в веб-интерфейсе).
# COLLECT_LIMIT — сколько вакансий скачивать на один поисковый запрос (по умолчанию 40);
# COLLECT_TOTAL — сколько всего за один прогон (по умолчанию 200): 5 запросов × 40 = 200,
#                при большем числе запросов сбор остановится на пределе;
# COLLECT_PAGES — сколько страниц выдачи листать (по умолчанию 1);
# COLLECT_QUERIES — сколько первых запросов из config/queries.txt брать (0 = все).
COLLECT_LIMIT=40
COLLECT_TOTAL=200
COLLECT_PAGES=1
COLLECT_QUERIES=0

# Регионы сбора: id регионов hh.ru через запятую (113 — вся Россия, 1 — Москва, 2 — СПб,
# можно имена: moscow, spb, rf). Один регион = только он; несколько = все перечисленные.
# Справочник id: https://api.hh.ru/areas/113 (или в ответе hh на /areas/113)
COLLECT_AREAS=113
# COLLECT_REMOTE=1 — собирать только удалёнку (в поиске hh уходит schedule=remote)
COLLECT_REMOTE=
# COLLECT_REFRESH_DAYS — не скачивать повторно карточки вакансий, которые уже видели
# меньше N дней назад (0 = скачивать всегда). Экономит запросы при ежедневном сборе.
COLLECT_REFRESH_DAYS=3

# Один отклик на компанию за N дней: остальные вакансии этой компании прячутся из очереди
# и из пакетной генерации писем (0 = правило выключено).
COMPANY_COOLDOWN_DAYS=10

# LLM для скоринга и генерации писем (OpenAI-совместимый API).
# Если не заполнено — работает офлайн-режим (правила + сборка письма из блоков).
# Примеры:
#   OpenAI:     LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_PROVIDER=openrouter  LLM_MODEL=anthropic/claude-3.5-sonnet
#   DeepSeek:   LLM_PROVIDER=deepseek    LLM_MODEL=deepseek-chat
#   Ollama:     LLM_PROVIDER=ollama      LLM_MODEL=llama3.1   (локально, ключ — любая непустая строка)
#   Яндекс:     LLM_PROVIDER=yandex      LLM_MODEL=<id модели>, LLM_BASE_URL из консоли Yandex Cloud
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Свой или корпоративный шлюз: адрес задаётся вручную (для готовых провайдеров не нужен)
LLM_BASE_URL=

# Параметры обращений к LLM
LLM_TIMEOUT=90
LLM_RETRIES=2
# LLM_JSON_MODE=1 — просить у модели строгий JSON (поддерживают не все провайдеры)
LLM_JSON_MODE=

# Источник вакансий: auto — API hh.ru (если настроен токен), иначе HTML-парсер;
# api — только API (ошибка вместо отката); html — только HTML.
HH_SOURCE=auto

# Токен приложения hh.ru (если заявка на dev.hh.ru одобрена).
# ВНИМАНИЕ: поддержка API для соискателей прекращена 15.12.2025 — заявки
# рассматривают только под сценарии работодателя (в т.ч. ИП / кадровое агентство).
# Токен приложения разрешено использовать ТОЛЬКО для привлечения работников и их
# трудоустройства (п.1.5 Условий API), поэтому личный поиск работы — через HTML
# (HH_SOURCE=html). Без токена всё работает через HTML-парсер, поля можно не заполнять.
# HH_APP_TOKEN — готовый токен из кабинета dev.hh.ru/admin (приоритетнее пары ниже).
# HH_CLIENT_ID + HH_CLIENT_SECRET — тогда токен запрашивается сам (POST /token).
HH_APP_TOKEN=
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Параметры обращений к API hh.ru
HH_API_TIMEOUT=30
HH_API_RETRIES=3

# --- Веб-интерфейс: вход и HTTPS -------------------------------------------------
# Нужны, когда сервер открыт по сети (например, VPS), а не только с этого компьютера.
# Логин и пароль спрашивает сам браузер (HTTP Basic). Пустое значение WEB_AUTH_PASSWORD
# означает «вход не настроен»: сервер тогда пускает только запросы с 127.0.0.1,
# остальным отвечает 403 — случайно выставленный наружу сервер данные не отдаст.
WEB_AUTH_USER=hh
WEB_AUTH_PASSWORD=
# Пути к сертификату и ключу. Если заданы оба — сервер поднимается по HTTPS.
# Самоподписанный сертификат для IP-адреса создаёт deploy/install.sh (openssl).
WEB_TLS_CERT=
WEB_TLS_KEY=
